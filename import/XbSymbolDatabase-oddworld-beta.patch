diff --git a/src/lib/libXbSymbolDatabase.c b/src/lib/libXbSymbolDatabase.c
index bdb743a..f2614f9 100644
--- a/src/lib/libXbSymbolDatabase.c
+++ b/src/lib/libXbSymbolDatabase.c
@@ -434,6 +434,54 @@ const char* XbSDB_SymbolReferenceToString(uint32_t xref_index)
 //       Otherwise, internal scan and XbSDB_LibraryToString will not function correctly.
 uint32_t XbSDB_LibraryToFlag(const char* library_name)
 {
+    // Debug-linked XDK builds name their libraries with a trailing 'D'
+    // (D3D8D, DSOUNDD, XAPILIBD, ...). They are the same APIs, so map them
+    // onto the retail flags instead of leaving the title unrecognised.
+    //
+    // Without this a debug build reports no D3D8 library at all, EmuUpdateLLEStatus
+    // forces bLLE_GPU on ("Fallback to LLE GPU."), every D3D patch is then skipped
+    // as "LLE GPU Enabled", and the game runs with no real device - no visible
+    // render window and garbage viewport/depth state handed back to the title.
+    if (strncmp(library_name, LIB_D3D8 "D", 8) == 0) {
+        return XBSDBLIB_D3D8;
+    }
+    if (strncmp(library_name, LIB_D3DX8 "D", 8) == 0) {
+        return XBSDBLIB_D3DX8;
+    }
+    if (strncmp(library_name, LIB_DSOUND "D", 8) == 0) {
+        return XBSDBLIB_DSOUND;
+    }
+    if (strncmp(library_name, LIB_XAPILIB "D", 8) == 0) {
+        return XBSDBLIB_XAPILIB;
+    }
+    if (strncmp(library_name, LIB_XGRAPHC "D", 8) == 0) {
+        return XBSDBLIB_XGRAPHC;
+    }
+    // Instrumented ('I' suffix) XDK builds: D3D8I, DSOUNDI, XAPILIBI, XGRAPHCI.
+    // Same APIs as retail with profiling hooks added, so map them onto the retail
+    // flags too - otherwise the same "Fallback to LLE GPU." path described above
+    // swallows every D3D patch. (LIB_D3DX8 "I" would be 7 chars, still fine for
+    // the 8-byte fixed-size library names in the XBE header.)
+    if (strncmp(library_name, LIB_D3D8 "I", 8) == 0) {
+        return XBSDBLIB_D3D8;
+    }
+    if (strncmp(library_name, LIB_D3DX8 "I", 8) == 0) {
+        return XBSDBLIB_D3DX8;
+    }
+    if (strncmp(library_name, LIB_DSOUND "I", 8) == 0) {
+        return XBSDBLIB_DSOUND;
+    }
+    if (strncmp(library_name, LIB_XAPILIB "I", 8) == 0) {
+        return XBSDBLIB_XAPILIB;
+    }
+    if (strncmp(library_name, LIB_XGRAPHC "I", 8) == 0) {
+        return XBSDBLIB_XGRAPHC;
+    }
+    // XACTENG's debug name is XACTENID, not XACTENGD.
+    if (strncmp(library_name, "XACTENID", 8) == 0) {
+        return XBSDBLIB_XACTENG;
+    }
+
     if (strncmp(library_name, LIB_D3D8, 8) == 0) {
         return XBSDBLIB_D3D8;
     }
