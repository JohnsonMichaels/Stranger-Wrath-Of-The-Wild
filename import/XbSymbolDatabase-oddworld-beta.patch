diff --git a/src/OOVPADatabase/D3D8LTCG/5849.inl b/src/OOVPADatabase/D3D8LTCG/5849.inl
index 61dec20..a6799a4 100644
--- a/src/OOVPADatabase/D3D8LTCG/5849.inl
+++ b/src/OOVPADatabase/D3D8LTCG/5849.inl
@@ -43,10 +43,30 @@ OOVPA_SIG_MATCH(
 );
 
 // ******************************************************************
-// * D3DDevice_SetPixelShader
-// ******************************************************************
+// * D3DDevice_SetPixelShaderProgram
+// ******************************************************************
+// * NOTE: This signature used to be registered as D3DDevice_SetPixelShader.
+// * It is not that function - the body it matches is SetPixelShaderProgram's:
+// * it builds the device-owned scratch X_PixelShader { RefCount = 1,
+// * D3DOwned = 0, pPSDef = argument } at pDevice + 0x924 and then tail-calls
+// * the real SetPixelShader with that struct pointer in EAX. The two bytes
+// * this OOVPA keys on, "C7 00 01 00 00 00" at +0x14 and "C7 81 28 09" at
+// * +0x1A, ARE that RefCount = 1 / D3DOwned = 0 construction.
+// *
+// * Verified against Oddworld: Stranger's Wrath (2004-05-22 "Final",
+// * D3D8LTCG 5849), whose own PDB names the two functions and their sizes:
+// *   D3DDevice_SetPixelShaderProgram  RVA 0x1F82D0  60 bytes -> XBE 0x208BF0
+// *   D3DDevice_SetPixelShader         RVA 0x1F8310 505 bytes -> XBE 0x208C30
+// * (delta 0x10920, cross-checked on 97 other D3D symbols, all exact.)
+// *
+// * Patching SetPixelShader here handed CxbxImpl_SetPixelShader a
+// * D3DPIXELSHADERDEF* where it expected an X_PixelShader*, so pPSDef was read
+// * out of the middle of the shader data - a non-null garbage pointer that
+// * sailed past the null guard and access-violated in the 228-byte memcpy.
+// * The real function is covered by D3DDevice_SetPixelShader_0__LTCG_eax1
+// * (sig 2048), which matches 0x208C30 exactly.
 //C70001000000C7812809
-OOVPA_SIG_HEADER_NO_XREF(D3DDevice_SetPixelShader,
+OOVPA_SIG_HEADER_NO_XREF(D3DDevice_SetPixelShaderProgram,
                          1048)
 OOVPA_SIG_MATCH(
 
